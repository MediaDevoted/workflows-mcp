# Workflows MCP — environment variable template.
# Copy to .env and fill in values. Lines ending in =REQUIRED must be set.

# ─── Transport ────────────────────────────────────────────────────────────────
WORKFLOWS_MCP_TRANSPORT=http
WORKFLOWS_MCP_PORT=3030
# Optional transport-level auth token (?auth= query param or X-MCP-Auth-Token header).
WORKFLOWS_MCP_AUTH_TOKEN=
MCP_AUTH_TOKEN=

# ─── Agent Platform (workflow store) ─────────────────────────────────────────
# Base URL of the agent-platform service. Required for all three workflow tools.
AGENT_PLATFORM_URL=REQUIRED
# Service key used for boot-time skills/permissions sync. Falls back to AGENT_PLATFORM_API_KEY / MCP_SYNC_API_KEY.
AGENT_PLATFORM_SYNC_KEY=
AGENT_PLATFORM_API_KEY=

# ─── Employee API (RBAC + audit) ──────────────────────────────────────────────
EMPLOYEE_API_URL=http://localhost:7991
# Service key for boot-time catalog sync and audit fallback. Also used as the
# approval token secret when WORKFLOWS_APPROVAL_TOKEN_SECRET is not set.
MCP_SYNC_API_KEY=
EMPLOYEE_AUTH_DISABLED=false
EMPLOYEE_AUTH_CACHE_SECONDS=30

# ─── RBAC permission keys (defaults match employee-api seed data) ─────────────
WORKFLOWS_READ_PERMISSION=WORKFLOWS_READ
WORKFLOWS_WRITE_PERMISSION=MANAGE_WORKFLOWS
WORKFLOWS_ADMIN_PERMISSIONS=MANAGE_WORKFLOWS,MANAGE_ACCESS,MANAGE_SETTINGS
WORKFLOWS_CROSS_TEAM_READ_PERMISSIONS=

# ─── Audit trail ─────────────────────────────────────────────────────────────
# Optional. When set, every tool call writes an audit row.
AUDIT_TRAIL_URL=
AUDIT_TRAIL_API_KEY=

# ─── Approval gate ───────────────────────────────────────────────────────────
# Secret used to sign approval tokens for write tools. Defaults to MCP_SYNC_API_KEY.
WORKFLOWS_APPROVAL_TOKEN_SECRET=

# ─── Catalog sync scope ───────────────────────────────────────────────────────
# Optional CSV of uppercase team keys. Leave empty to make the connector visible to all teams.
MCP_ALLOWED_TEAMS=

# ─── Tuning ───────────────────────────────────────────────────────────────────
RESPONSE_MAX_BYTES=200000

# ─── Semantic search (OpenAI embeddings + pgvector) ───────────────────────────
# When OPENAI_API_KEY is unset, workflows_search degrades gracefully to
# literal trigger-phrase ranking (degraded: true in the response).
OPENAI_API_KEY=
# Postgres+pgvector sidecar password (used by compose interpolation).
EMBEDDINGS_DB_PASSWORD=REQUIRED
# Full DSN; the default points at the compose sidecar.
EMBEDDINGS_DB_URL=postgres://workflows:placeholder@workflows-mcp-pgvector:5432/embeddings
EMBEDDINGS_SYNC_INTERVAL_MS=300000
EMBEDDINGS_BATCH_SIZE=50

# ─── Dynamic toolsets ─────────────────────────────────────────────────────────
MCP_DYNAMIC_TOOLSETS=

# ─── Build (required at Docker build time, not at runtime) ───────────────────
# GitHub Packages token to pull @mediadevoted/mcp-passthrough.
# Pass as: docker compose build --build-arg NPM_TOKEN=...
# NPM_TOKEN=
